rules_version = '2';

// Toda la app (móvil y web) habla con Firestore a través del backend de
// Express, que usa el Admin SDK y por lo tanto IGNORA estas reglas. Estas
// reglas solo aplican a quien intente leer/escribir Firestore directamente
// (con el SDK de cliente o la API REST), así que las dejamos cerradas por
// completo: ni siquiera un usuario autenticado puede tocar la base de datos
// sin pasar por el backend.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
